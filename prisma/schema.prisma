generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  documents Document[]
  invites   Invite[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           Role         @default(WORKER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  chatSessions     ChatSession[]
  uploadedDocs     Document[]         @relation("UploadedBy")
  guidanceSessions GuidanceSession[]
}

enum Role {
  ADMIN
  WORKER
}

model Invite {
  id             String       @id @default(cuid())
  email          String
  token          String       @unique @default(cuid())
  role           Role         @default(WORKER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  accepted       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  @@unique([email, organizationId])
}

model Document {
  id                String         @id @default(cuid())
  docType           DocType        @default(STANDARD)
  title             String?
  description       String?
  expertCaptureData Json?
  fileName          String
  fileType          String
  mimeType          String?
  fileUrl           String
  fileSize          Int
  status            DocumentStatus @default(PENDING)
  pageCount         Int?
  extractedText     String?
  errorMessage      String?
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id])
  uploadedById      String
  uploadedBy        User           @relation("UploadedBy", fields: [uploadedById], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  chunks           DocumentChunk[]
  guidanceSessions GuidanceSession[]
}

enum DocType {
  STANDARD
  EXPERT_CAPTURE
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  content    String
  chunkIndex Int
  pageNumber Int?
  embedding  Unsupported("vector(1536)")
  documentId String
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime                    @default(now())

  @@index([documentId])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id             String      @id @default(cuid())
  role           MessageRole
  content        String
  sourceChunkIds String[]
  sessionId      String
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
}

enum MessageRole {
  USER
  ASSISTANT
}

model GuidanceSession {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id])
  documentId  String
  document    Document              @relation(fields: [documentId], references: [id])
  currentStep Int                   @default(1)
  totalSteps  Int
  status      GuidanceSessionStatus @default(IN_PROGRESS)
  startedAt   DateTime              @default(now())
  completedAt DateTime?
  updatedAt   DateTime              @updatedAt

  @@index([userId])
  @@index([documentId])
}

enum GuidanceSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}
